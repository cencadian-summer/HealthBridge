# Remote MongoDB Atlas
REMOTE_DATABASE_URL=mongodb+srv://username:password@cluster0.example.mongodb.net/your-database-name?retryWrites=true&w=majority

# Optional compatibility alias (set this to the same remote URL above)
DATABASE_URL=mongodb+srv://username:password@cluster0.example.mongodb.net/your-database-name?retryWrites=true&w=majority

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase Auth for public website users
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# OpenAI chatbot (model is optional and defaults to gpt-5.6-luna)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
