# Remote MongoDB Atlas
REMOTE_DATABASE_URL=mongodb+srv://username:password@cluster0.example.mongodb.net/your-database-name?retryWrites=true&w=majority

# Optional compatibility alias (set this to the same remote URL above)
DATABASE_URL=mongodb+srv://username:password@cluster0.example.mongodb.net/your-database-name?retryWrites=true&w=majority

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. Use the public production URL; no trailing slash.
# Netlify URLs are detected automatically, but set this explicitly when using a custom domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# DigitalOcean Spaces (S3 API endpoint and public CDN; no trailing slashes)
DO_SPACES_BUCKET=your-space-name
DO_SPACES_REGION=tor1
DO_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY_ID=YOUR_SPACES_ACCESS_KEY_ID
DO_SPACES_SECRET_ACCESS_KEY=YOUR_SPACES_SECRET_ACCESS_KEY
DO_SPACES_CDN_URL=https://your-space-name.tor1.cdn.digitaloceanspaces.com
NEXT_PUBLIC_DO_SPACES_CDN_URL=https://your-space-name.tor1.cdn.digitaloceanspaces.com

# Supabase Auth for public website users
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# OpenAI chatbot (model is optional and defaults to gpt-5.6-luna)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
